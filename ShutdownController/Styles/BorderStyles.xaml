<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary card: flat accent-blue surface that always carries white text/icons. -->
    <Style x:Key="borderBlueTheme" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.CardPrimary}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary card: slightly lighter flat surface for grouped settings/sliders. -->
    <Style x:Key="borderbrightBlueTheme" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.CardSecondary}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.18"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
