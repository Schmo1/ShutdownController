{
  "AppConfig": {
    "configurationsFolder": "ShutdownController\\Configurations",
    "appPropertiesFileName": "AppProperties.json"
  },

  "Serilog": {
    "Using": ["Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": { "path": "Logs/log.txt" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}