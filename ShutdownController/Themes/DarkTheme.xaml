<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- DARK THEME  –  modern flat, blue accent                       -->
    <!-- Keys mirror LightTheme.xaml one-to-one.                        -->
    <!-- ============================================================= -->

    <!-- Raw colours -->
    <Color x:Key="Color.Accent">#4C82F0</Color>
    <Color x:Key="Color.AccentSoft">#4C82F0</Color>

    <!-- Structural surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#0E1320"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#151C2B"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0B1120"/>

    <!-- Coloured cards that always carry white text / white icons -->
    <SolidColorBrush x:Key="Brush.CardPrimary" Color="#1B2740"/>
    <SolidColorBrush x:Key="Brush.CardSecondary" Color="#212E48"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4C82F0"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6497F4"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3A6FD8"/>

    <!-- Foreground -->
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextOnColored" Color="#EAF0FB"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9AA6BC"/>

    <!-- Lines / inputs / controls -->
    <SolidColorBrush x:Key="Brush.Border" Color="#2A3547"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#2C3B58"/>
    <SolidColorBrush x:Key="Brush.InputHover" Color="#37476A"/>
    <SolidColorBrush x:Key="Brush.Track" Color="#384662"/>
    <SolidColorBrush x:Key="Brush.TrackFill" Color="#4C82F0"/>
    <SolidColorBrush x:Key="Brush.ToggleOff" Color="#3B4A66"/>

    <!-- Semantic state -->
    <SolidColorBrush x:Key="Brush.Success" Color="#33D389"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF5B60"/>

    <!-- Graph series -->
    <SolidColorBrush x:Key="Brush.GraphPrimary" Color="#6FD89A"/>
    <SolidColorBrush x:Key="Brush.GraphSecondary" Color="#F2B457"/>
    <SolidColorBrush x:Key="Brush.GraphPrimaryFill" Color="#456FD89A"/>
    <SolidColorBrush x:Key="Brush.GraphSecondaryFill" Color="#45F2B457"/>
    <SolidColorBrush x:Key="Brush.GraphGrid" Color="#FFFFFF"/>

    <!-- Popup (combo box drop down) -->
    <SolidColorBrush x:Key="Brush.PopupSurface" Color="#1B2436"/>
    <SolidColorBrush x:Key="Brush.PopupText" Color="#E8EDF5"/>

</ResourceDictionary>
