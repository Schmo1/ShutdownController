<UserControl x:Class="ShutdownController.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ShutdownController.Views"
             xmlns:converters="clr-namespace:ShutdownController.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="500">
    <UserControl.Resources>
        <converters:BoolInvertConverter x:Key="MyBoolInvertConverter"/>
        <converters:StringToDoubleConverter x:Key="MyStringToDoubleConverter"/>
    </UserControl.Resources>

    <Grid Margin="15 20 30 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overview graph -->
        <Border Style="{StaticResource borderBlueTheme}" Height="210">
            <Grid Margin="15 12 15 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title + legend -->
                <Grid>
                    <TextBlock Text="Overview" Style="{StaticResource textBlockTitel}" FontSize="16" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#8fdc8f" VerticalAlignment="Center"/>
                        <TextBlock Text="Read" Foreground="White" FontSize="12" Margin="5 0 15 0" VerticalAlignment="Center"/>
                        <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#f0a94a" VerticalAlignment="Center"/>
                        <TextBlock Text="Write" Foreground="White" FontSize="12" Margin="5 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Plot area -->
                <Grid Grid.Row="1" Margin="0 8 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!-- Y axis labels -->
                    <Grid Height="140" Width="50" Margin="0 0 4 0">
                        <TextBlock Text="{Binding YAxisMaxLabel, FallbackValue=3 MB/s}" Foreground="White" FontSize="11" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding YAxisMidLabel}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="0 MB/s" Foreground="White" FontSize="11" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Canvas -->
                    <Canvas Grid.Column="1" Width="430" Height="140" ClipToBounds="True">
                        <Line X1="0" Y1="0" X2="430" Y2="0" Stroke="White" StrokeThickness="1" Opacity="0.25"/>
                        <Line X1="0" Y1="70" X2="430" Y2="70" Stroke="White" StrokeThickness="1" Opacity="0.25"/>
                        <Line X1="0" Y1="140" X2="430" Y2="140" Stroke="White" StrokeThickness="1" Opacity="0.4"/>
                        <Polygon Points="{Binding PrimaryArea}" Fill="#458fdc8f"/>
                        <Polygon Points="{Binding SecondaryArea}" Fill="#45f0a94a"/>
                        <Polyline Points="{Binding PrimaryPoints}" Stroke="#8fdc8f" StrokeThickness="2"/>
                        <Polyline Points="{Binding SecondaryPoints}" Stroke="#f0a94a" StrokeThickness="2"/>
                    </Canvas>

                    <!-- X axis labels -->
                    <Grid Grid.Column="1" Grid.Row="1" Width="430" Margin="0 3 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="0 s" Foreground="White" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="10 s" Foreground="White" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="20 s" Foreground="White" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="30 s" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0 15 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!-- Seconds / speed inputs -->
            <Border Style="{StaticResource borderbrightBlueTheme}" Margin="0 0 15 0">
                <Grid Margin="15 12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Seconds:" Foreground="White" FontSize="17" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource inputTextbox}" HorizontalAlignment="Right"
                                 Text="{Binding Seconds, FallbackValue=20}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0 12 0 0">
                        <TextBlock Text="Observing speed (MB/s):" Foreground="White" FontSize="17" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource inputTextbox}" HorizontalAlignment="Right"
                                 Text="{Binding ObservingSpeed, Converter={StaticResource MyStringToDoubleConverter}, FallbackValue=1}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Drive + Read/Write toggle -->
            <StackPanel Grid.Column="1">
                <ComboBox Style="{StaticResource ComboBoxStyle1}" HorizontalAlignment="Right" Margin="0 0 0 12"
                          ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                          DisplayMemberPath="Display"/>

                <Border Style="{StaticResource borderBlueTheme}">
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Button Style="{StaticResource monitorToggleButton}" Command="{Binding SelectPrimaryCommand}"
                                IsEnabled="{Binding IsPrimarySelected, Converter={StaticResource MyBoolInvertConverter}}">
                            <StackPanel>
                                <Image Source="/Resources/Images/read.png" Width="30"/>
                                <TextBlock Text="Read" Style="{StaticResource optionButtonText}" HorizontalAlignment="Center" Margin="0 6 0 0" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource monitorToggleButton}" Command="{Binding SelectSecondaryCommand}"
                                IsEnabled="{Binding IsSecondarySelected, Converter={StaticResource MyBoolInvertConverter}}">
                            <StackPanel>
                                <Image Source="/Resources/Images/write.png" Width="30"/>
                                <TextBlock Text="Write" Style="{StaticResource optionButtonText}" HorizontalAlignment="Center" Margin="0 6 0 0" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Start / Stop -->
        <Button Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 10 0 5"
                Style="{StaticResource startStopButton}" Command="{Binding StartStopCommand}"/>
    </Grid>
</UserControl>
