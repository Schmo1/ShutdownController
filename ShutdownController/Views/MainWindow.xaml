<Window x:Class="ShutdownController.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutdownController.Views"
        xmlns:viewModels="clr-namespace:ShutdownController.ViewModels"
        mc:Ignorable="d"
        Width="830" Height="550" WindowStartupLocation="CenterScreen"
        MinWidth="830" MaxWidth="800" MaxHeight="550" MinHeight="550" 
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanMinimize"
        Background="Transparent"
        Icon="/Resources/Images/Icons/ShutdownManager.ico"
        Name="window" >
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Background="{DynamicResource Brush.Window}"
         Padding="20"
         CornerRadius="25"
         MouseDown="Border_MouseDown"
         Margin="5">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1"
                           BlurRadius="5"
                           Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="83"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="2" CornerRadius="25" Style="{StaticResource borderbrightBlueTheme}" Margin="10,20,10,20">            
                <local:ShutdownOptionsView>
                    <local:ShutdownOptionsView.DataContext>
                        <viewModels:ShutdownOptionsViewModel />
                    </local:ShutdownOptionsView.DataContext>
                </local:ShutdownOptionsView>
            </Border>


            <Border Grid.ColumnSpan="2" CornerRadius="25" Margin="5,20,10,20"
                    Background="{DynamicResource Brush.Surface}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0"
                                    BlurRadius="20"
                                    Opacity="0.18"/>
                </Border.Effect>

                <Grid Margin="78 0 0 0">
                    <ContentControl Content="{Binding CurrentView}"/>
                    <Button Style="{StaticResource menuButton}" Command="{Binding ShowAboutCommand}"
                            Background="{DynamicResource Brush.Accent}"
                            Width="30" Height="30" Margin="0,12,18,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="About">
                        <Image Source="/Resources/Images/information-button.png" Width="22"/>
                    </Button>
                </Grid>
            </Border>

            <Border CornerRadius="16" Background="{DynamicResource Brush.Sidebar}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0"
                                      BlurRadius="20"
                                      Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <StackPanel>
                        <Button Style="{StaticResource menuButton}" Margin="15,25,15,20" Command="{Binding TimerViewCommand}" >
                            <Image Source="/Resources/Images/timer.png" Width="23" />                     
                        </Button>
                        <Button Style="{StaticResource menuButton}"  Command="{Binding ClockViewCommand}">
                            <Image Source="/Resources/Images/wall-clock.png" Width="23" />                          
                        </Button>
                        <Button Style="{StaticResource menuButton}"  Command="{Binding DownUploadViewCommand}" >
                            <Image Source="/Resources/Images/upside-down.png" Width="23" />                           
                        </Button>
                        <Button Style="{StaticResource menuButton}" Command="{Binding DiskViewCommand}">
                            <Image Source="/Resources/Images/hosting.png" Width="23" />
                        </Button>

                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom">
                        <Button Style="{StaticResource menuButton}" Command="{Binding SettingsViewCommand}">
                            <Image Source="/Resources/Images/settings.png" Width="28" />                          
                        </Button>

                        <Button Style="{StaticResource menuButton}" VerticalAlignment="Bottom" Command="{Binding CloseAppCommand}">
                            <Image Source="/Resources/Images/close.png" Width="28" />                         
                        </Button>
                    </StackPanel>


                </Grid>

            </Border>
        </Grid>
    </Border>
</Window>
